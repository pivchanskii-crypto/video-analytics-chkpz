# ===========================================================================
# Video Surveillance Platform — единый корневой .env для docker-compose.
# Скопируйте в .env:  cp .env.example .env
# Этот файл — шаблон; реальный .env не коммитьте.
# ===========================================================================

# --- PostgreSQL (контейнер db) ---
POSTGRES_DB=surveillance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Хост внутри Docker-сети; для контейнеров всегда "db".
POSTGRES_HOST=db
POSTGRES_PORT=5433

# Полный DSN для backend (FastAPI + Alembic).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/surveillance

# --- Redis (контейнер redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
VIOLATIONS_QUEUE=violations_queue

# --- JWT / безопасность ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SMTP (Email-оповещения операторов, Фаза 5) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# STARTTLS (порт 587) или прямой SSL (порт 465).
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_DELIVERY_TIMEOUT_SECONDS=60

# --- Приложение ---
DEBUG=false
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- CV-воркер: RTSP-поток и идентификатор камеры ---
# Если RTSP_URL пуст или поток недоступен, воркер генерирует тестовый
# «чёрный экран», чтобы можно было проверить путь воркер -> Redis -> backend -> БД.
RTSP_URL=
CAMERA_ID=1

# --- Сидинг БД (для проверки сквозного пути) ---
# Идентификаторы камер (через запятую), которые воркеры «видят». Создаются при
# старте backend, если отсутствуют. Без существующей камеры обработчик событий
# отклоняет сообщения воркера.
SEED_CAMERA_IDS=1,2
# Необязательный администратор для входа в API (POST /api/v1/auth/login).
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@example.com