# Скопируйте в .env и заполните реальными значениями.

# --- Redis (брокер очередей) ---
REDIS_URL=redis://localhost:6379/0
VIOLATIONS_QUEUE=violations_queue

# --- RTSP-поток и камера ---
RTSP_URL=rtsp://user:password@localhost:554/stream
# Идентификатор камеры — попадёт в сообщение о нарушении (camera_id).
CAMERA_ID=1