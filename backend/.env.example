# Скопируйте в .env и заполните реальными значениями.

# --- База данных ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/surveillance

# --- JWT / безопасность ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
# Сроки жизни токенов из ТЗ: access 1 час, refresh 7 дней.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis (трансляция нарушений по WebSocket) ---
REDIS_URL=redis://localhost:6379/0
VIOLATIONS_QUEUE=violations_queue

# --- SMTP (Email-оповещения, Фаза 5) ---
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# STARTTLS (порт 587) либо прямой SSL (порт 465).
SMTP_USE_TLS=false
SMTP_USE_SSL=false
# Максимальное время доставки оповещения (сек).
ALERT_DELIVERY_TIMEOUT_SECONDS=60

# --- Приложение ---
DEBUG=false